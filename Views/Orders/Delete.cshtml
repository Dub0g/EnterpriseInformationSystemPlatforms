@model Order

@{
    ViewData["Title"] = "Видалити замовлення";
}

<h1>Видалити замовлення №@Model.ID</h1>

<p class="text-danger">
    Увага: разом із замовленням будуть видалені всі його позиції (послуги).
</p>

<dl class="row">
    <dt class="col-sm-2">Клієнт</dt>
    <dd class="col-sm-10">@Model.Client.LastName @Model.Client.FirstName</dd>

    <dt class="col-sm-2">Дата прийому</dt>
    <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

    <dt class="col-sm-2">Дата видачі</dt>
    <dd class="col-sm-10">@Model.DeliveryDate.ToShortDateString()</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>