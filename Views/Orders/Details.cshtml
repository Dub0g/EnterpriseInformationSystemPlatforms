@model Order

@{
    ViewData["Title"] = "Деталі замовлення";
    decimal total = Model.OrderDetails.Sum(od => od.Quantity * od.UnitPrice);
}

<h1>Замовлення №@Model.ID</h1>

<dl class="row">
    <dt class="col-sm-2">Клієнт</dt>
    <dd class="col-sm-10">
        <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientID">
            @Model.Client.LastName @Model.Client.FirstName
        </a>
    </dd>

    <dt class="col-sm-2">Дата прийому</dt>
    <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

    <dt class="col-sm-2">Дата видачі</dt>
    <dd class="col-sm-10">@Model.DeliveryDate.ToShortDateString()</dd>
</dl>

<h4 class="mt-4">Позиції замовлення</h4>

<p>
    <a asp-action="CreateDetail" asp-route-orderId="@Model.ID" class="btn btn-primary btn-sm">Додати послугу</a>
</p>

@if (Model.OrderDetails.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Послуга</th>
                <th>К-сть</th>
                <th>Ціна за од.</th>
                <th>Сума</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                <tr>
                    <td>@detail.Service.Name</td>
                    <td>@detail.Quantity</td>
                    <td>@detail.UnitPrice.ToString("0.00")</td>
                    <td>@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</td>
                    <td>
                        <a asp-action="EditDetail" asp-route-id="@detail.ID">Редагувати</a> |
                        <a asp-action="DeleteDetail" asp-route-id="@detail.ID">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Разом:</th>
                <th>@total.ToString("0.00")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}
else
{
    <p>До замовлення ще не додано жодної послуги.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.ID">Редагувати замовлення</a> |
    <a asp-action="Index">Назад до списку</a>
</div>