@page
@model Lab_4.Pages.ServicesPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Services</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Services.ID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Services.Name" class="control-label"></label>
                <input asp-for="Services.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Services.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Services.Description" class="control-label"></label>
                <input asp-for="Services.Description" class="form-control" />
                <span asp-validation-for="Services.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Services.OrderDetails" class="control-label"></label>
                <input asp-for="Services.OrderDetails" class="form-control" />
                <span asp-validation-for="Services.OrderDetails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
