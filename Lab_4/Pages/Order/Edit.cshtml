@page "{id:int}"
@model Lab_4.Pages.Order.EditModel
@{ ViewData["Title"] = "Редагування замовлення"; }

<h1>Редагування замовлення №@Model.Order.ID</h1>

<form method="post">
    <partial name="_OrderForm" for="Order" view-data="ViewData" />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
</form>