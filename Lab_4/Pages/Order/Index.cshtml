@page
@model Lab_4.Pages.Order.IndexModel
@{
    ViewData["Title"] = "Замовлення";
}

<h1>Замовлення</h1>
<a asp-page="Create" class="btn btn-primary mb-3">Нове замовлення</a>

<table class="table table-striped">
    <thead>
        <tr><th>№</th><th>Клієнт</th><th>Прийом</th><th>Видача</th><th>Послуги</th><th>Сума</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Orders)
        {
            <tr>
                <td>@o.ID</td>
                <td>@o.Client?.LastName @o.Client?.FirstName</td>
                <td>@o.Date.ToShortDateString()</td>
                <td>@o.DeliveryDate.ToShortDateString()</td>
                <td>
                    @foreach (var d in o.OrderDetails)
                    {
                        <div>@d.Service.Name × @d.Quantity (@d.UnitPrice.ToString("0.00"))</div>
                    }
                </td>
                <td>@o.OrderDetails.Sum(d => d.Quantity * d.UnitPrice).ToString("0.00")</td>
                <td class="text-nowrap">
                    <a asp-page="Edit" asp-route-id="@o.ID" class="btn btn-sm btn-outline-primary">Редагувати</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@o.ID" class="d-inline"
                          onsubmit="return confirm('Видалити замовлення №@o.ID?');">
                        <button class="btn btn-sm btn-outline-danger">Видалити</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>