@page "/clients/edit"
@using Microsoft.EntityFrameworkCore
@using Lab_5.Models
@inject IDbContextFactory<Lab_5_1Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>
<h2>Clients</h2>
<hr />
@if (Clients is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Clients" OnValidSubmit="UpdateClients" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Clients.ID" value="@Clients.ID" />
                
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="lastname" class="form-label">LastName:</label>
                    <InputText id="lastname" @bind-Value="Clients.LastName" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Clients.LastName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="firstname" class="form-label">FirstName:</label>
                    <InputText id="firstname" @bind-Value="Clients.FirstName" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Clients.FirstName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="middlename" class="form-label">MiddleName:</label>
                    <InputText id="middlename" @bind-Value="Clients.MiddleName" class="form-control" />
                    <ValidationMessage For="() => Clients.MiddleName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="address" class="form-label">Address:</label>
                    <InputText id="address" @bind-Value="Clients.Address" class="form-control" />
                    <ValidationMessage For="() => Clients.Address" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone:</label>
                    <InputText id="phone" @bind-Value="Clients.Phone" class="form-control" />
                    <ValidationMessage For="() => Clients.Phone" class="text-danger" />
                </div>
                
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/clients">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int ID { get; set; }

    [SupplyParameterFromForm]
    private Clients? Clients { get; set; }

    [PersistentState]
    public Clients? ClientsState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Clients ??= ClientsState ??= await context.Clients.FirstOrDefaultAsync(m => m.ID == ID);

        if (Clients is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateClients()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Clients!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ClientsExists(Clients!.ID))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/clients");
    }

    private bool ClientsExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Clients.Any(e => e.ID == id);
    }
}