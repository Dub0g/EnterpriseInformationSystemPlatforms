@page "/clients/delete"
@using Microsoft.EntityFrameworkCore
@using Lab_5.Models
@inject IDbContextFactory<Lab_5_1Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Clients</h2>
    <hr />
    @if (clients is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">LastName</dt>
            <dd class="col-sm-10">@clients.LastName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FirstName</dt>
            <dd class="col-sm-10">@clients.FirstName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MiddleName</dt>
            <dd class="col-sm-10">@clients.MiddleName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@clients.Address</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Phone</dt>
            <dd class="col-sm-10">@clients.Phone</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Orders</dt>
            <dd class="col-sm-10">@clients.Orders</dd>
        </dl>
        <EditForm method="post" Model="clients" OnValidSubmit="DeleteClients" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(clients is null)">Delete</button> |
            <a href="/clients">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Clients? clients;

    [SupplyParameterFromQuery]
    private int ID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        clients = await context.Clients.FirstOrDefaultAsync(m => m.ID == ID);

        if (clients is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteClients()
    {
        using var context = DbFactory.CreateDbContext();
        context.Clients.Remove(clients!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/clients");
    }
}
